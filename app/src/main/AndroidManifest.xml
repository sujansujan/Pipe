<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Zero analytics, zero tracking, NO android.permission.INTERNET -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pipe">

        <!-- 1. Main Single-Screen Terminal Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Static App Shortcuts (long-press icon or UbikiTouch App Shortcuts -> pipe overlay) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 2. Floating ASCII Overlay Mode (launchable directly from UbikiTouch, shortcuts, tile, or assist) -->
        <activity
            android:name=".PipeOverlayActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/overlay_name"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Pipe.Overlay"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Digital Assistant / Long-press Home or Search key opens the floating overlay -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEARCH_LONG_PRESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 3. UbikiTouch / Launcher Shortcut Creator (`ACTION_CREATE_SHORTCUT` -> "pipe overlay") -->
        <activity
            android:name=".OverlayShortcutCreatorActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/overlay_shortcut_label"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          4. Default Search Engine Receiver (`WebSearchReceiverActivity`):
             - System Web Search (`ACTION_WEB_SEARCH` & `ACTION_SEARCH`)
             - Custom Browser Search Engine URL (`pipe://search?q=%s` & `https://pipe.local/search?q=%s`)
             Immediately parses the keyword prefix and forwards to the target service with zero UI delay.
        -->
        <activity
            android:name=".WebSearchReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/search_engine_label"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Custom URI scheme for setting `pipe://search?q=%s` as default search engine in browsers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="search"
                    android:scheme="pipe" />
            </intent-filter>
            <!-- HTTP/HTTPS pseudo-host `https://pipe.local/search?q=%s` for browsers requiring http(s) search URLs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pipe.local"
                    android:pathPrefix="/search"
                    android:scheme="https" />
                <data
                    android:host="pipe.local"
                    android:pathPrefix="/search"
                    android:scheme="http" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <!-- 5. Share Sheet (`ACTION_SEND`) & Text Selection (`ACTION_PROCESS_TEXT`) Router -->
        <activity
            android:name=".TextPipeActivity"
            android:exported="true"
            android:label="@string/pipe_selection"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 6. Home-Screen ASCII Search Widget (opens Floating Overlay on tap) -->
        <receiver
            android:name=".widget.PipeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pipe_widget_info" />
        </receiver>

        <!-- 7. Quick Settings Tile (opens Floating Overlay on tap) -->
        <service
            android:name=".tile.PipeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pipe"
            android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
