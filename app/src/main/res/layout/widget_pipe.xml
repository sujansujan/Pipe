<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:minHeight="52dp">

        <ImageView
            android:id="@+id/widget_bg_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_frame_bg"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <LinearLayout
            android:id="@+id/widget_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/widget_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono_bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="&gt; "
                android:textColor="#FF79C6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_prompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/mono_regular"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:minHeight="40dp"
                android:singleLine="true"
                android:text="pipe for???"
                android:textColor="#6272A4"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_scope_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="40dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:singleLine="true"
                android:text="[all]"
                android:textColor="#6272A4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_btn_calc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="40dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:text="[=]"
                android:textColor="#8BE9FD"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_btn_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="40dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:text="[+]"
                android:textColor="#8BE9FD"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_btn_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="40dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:text="[::]"
                android:textColor="#8BE9FD"
                android:textSize="13sp" />

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
